#!/bin/bash
#PBS -N goalexit_shuffled_kd
#PBS -l select=1:ncpus=8:ngpus=1:mem=64gb
#PBS -l walltime=04:00:00
#PBS -j oe

set -euo pipefail

: "${GOALEXIT_EXPECTED_COMMIT:?GOALEXIT_EXPECTED_COMMIT is required}"
: "${GOALEXIT_TRACKED_ARCHIVE:?GOALEXIT_TRACKED_ARCHIVE is required}"
: "${GOALEXIT_GIT_ARCHIVE:?GOALEXIT_GIT_ARCHIVE is required}"
: "${GOALEXIT_TRANSFER_DIR:?GOALEXIT_TRANSFER_DIR is required}"
: "${GOALEXIT_PYTHON:?GOALEXIT_PYTHON is required}"
: "${GOALEXIT_RESULT_BASE:?GOALEXIT_RESULT_BASE is required}"
: "${GOALEXIT_BASE_RESULTS:?GOALEXIT_BASE_RESULTS is required}"

TRANSFER=${GOALEXIT_TRANSFER_DIR}
PYTHON=${GOALEXIT_PYTHON}
RUN_TAG=${PBS_JOBID%%.*}
RUN_ROOT=/tmp/goalexit_shuffled_kd_${RUN_TAG}
PROJECT=${RUN_ROOT}/project
RESULT_ROOT=${GOALEXIT_RESULT_BASE}/${RUN_TAG}
BASE_RESULTS=${GOALEXIT_BASE_RESULTS}
EXPECTED_PAYLOAD_SHA=61c011d7d6bddb5a28c037b6e26e3c24c5f5cc99efd9d5c16dcec17c8ebc40c1

mkdir -p "$PROJECT" "$RESULT_ROOT"
exec > >(tee -a "$RESULT_ROOT/run.log") 2>&1

snapshot() {
  local label=$1
  local present=()
  local relative
  for relative in \
    experiments/postfeedback_shuffled_kd \
    research_storage/checkpoints/postfeedback_shuffled_kd \
    research_storage/predictions/postfeedback_shuffled_kd \
    artifacts/metrics/postfeedback_shuffled_kd.json \
    docs/18_POSTFEEDBACK_SHUFFLED_KD_REPORT.md
  do
    if [ -e "$PROJECT/$relative" ]; then
      present+=("$relative")
    fi
  done
  if [ "${#present[@]}" -gt 0 ]; then
    tar -czf "$RESULT_ROOT/${label}.tar.gz" -C "$PROJECT" "${present[@]}"
  fi
  printf 'snapshot=%s\ntime=%s\ncommit=%s\nhost=%s\n' \
    "$label" "$(date -Is)" "$GOALEXIT_EXPECTED_COMMIT" "$(hostname)" \
    > "$RESULT_ROOT/${label}.txt"
}

on_exit() {
  local job_status=$?
  trap - EXIT
  set +e
  snapshot exit_latest
  printf 'exit_status=%s\ntime=%s\n' "$job_status" "$(date -Is)" \
    > "$RESULT_ROOT/exit_status.txt"
  exit "$job_status"
}
trap on_exit EXIT

payload_sha=$(cat \
  "$TRANSFER/goalexit_payload.part0" \
  "$TRANSFER/goalexit_payload.part1" \
  "$TRANSFER/goalexit_payload.part2" \
  "$TRANSFER/goalexit_payload.part3" | sha256sum | cut -d ' ' -f 1)
test "$payload_sha" = "$EXPECTED_PAYLOAD_SHA"
test -f "$BASE_RESULTS"
test -f "$GOALEXIT_TRACKED_ARCHIVE"
test -f "$GOALEXIT_GIT_ARCHIVE"

cat \
  "$TRANSFER/goalexit_payload.part0" \
  "$TRANSFER/goalexit_payload.part1" \
  "$TRANSFER/goalexit_payload.part2" \
  "$TRANSFER/goalexit_payload.part3" | tar -xzf - -C "$PROJECT"
tar -xzf "$BASE_RESULTS" -C "$PROJECT"
tar -xzf "$GOALEXIT_TRACKED_ARCHIVE" -C "$PROJECT"
tar -xzf "$GOALEXIT_GIT_ARCHIVE" -C "$PROJECT"

test "$(git -C "$PROJECT" rev-parse HEAD)" = "$GOALEXIT_EXPECTED_COMMIT"
test -z "$(git -C "$PROJECT" status --porcelain)"

export PYTHONPATH="$PROJECT/src"
export OMP_NUM_THREADS=2
export MKL_NUM_THREADS=2
cd "$PROJECT"

echo "job_id=${PBS_JOBID}"
echo "host=$(hostname)"
nvidia-smi --query-gpu=index,name,uuid,memory.total,driver_version --format=csv,noheader
"$PYTHON" -c 'import torch; assert torch.cuda.is_available(); print(torch.__version__, torch.version.cuda, torch.cuda.get_device_name(0), flush=True)'
"$PYTHON" -m pytest -q

"$PYTHON" -m goalexit.eval.postfeedback_shuffled_kd \
  --config configs/postfeedback_shuffled_kd.yaml --stage students
snapshot students_complete

"$PYTHON" -m goalexit.eval.postfeedback_shuffled_kd \
  --config configs/postfeedback_shuffled_kd.yaml --stage analyze
snapshot complete

sha256sum \
  artifacts/metrics/postfeedback_shuffled_kd.json \
  docs/18_POSTFEEDBACK_SHUFFLED_KD_REPORT.md \
  > "$RESULT_ROOT/final_sha256.txt"
